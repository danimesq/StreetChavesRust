{
  "schema_version": 1,
  "application": {
    "id": "street-chaves",
    "name": "Street Chaves"
  },
  "wasm": {
    "javascript_glue": "pkg/street_chaves_rust.js",
    "wasm_module": "pkg/street_chaves_rust_bg.wasm"
  },
  "assets": [
    {
      "id": "stage_01",
      "path": "assets/images/stages/stage-01.bmp",
      "kind": "image"
    },
    {
      "id": "fighter_01",
      "path": "assets/images/fighters/C01.bmp",
      "kind": "image"
    },
    {
      "id": "fighter_ini_01",
      "path": "assets/data/C01.ini",
      "kind": "data"
    },
    {
      "id": "fighter_04",
      "path": "assets/images/fighters/C04.bmp",
      "kind": "image"
    },
    {
      "id": "fighter_ini_04",
      "path": "assets/data/C04.ini",
      "kind": "data"
    },
    {
      "id": "game_settings",
      "path": "assets/data/Jogo.ini",
      "kind": "data"
    },
    {
      "id": "effect_slot_001",
      "path": "assets/audio/effects/Som-02.ogg",
      "fallbacks": [
        "assets/audio/effects/Som-02.m4a",
        "assets/audio/effects/Som-02.wav"
      ],
      "volume_percent": 100,
      "kind": "audio"
    },
    {
      "id": "fight_music",
      "path": "assets/audio/music/Musica-01.ogg",
      "fallbacks": [
        "assets/audio/music/Musica-01.m4a",
        "assets/audio/music/Musica-01.mp3"
      ],
      "volume_percent": 100,
      "kind": "audio"
    }
  ]
}
